# Server settings (systemd reads /etc/agentvps/environment).
AGENTVPS_HOST=0.0.0.0
AGENTVPS_PORT=8080
AGENTVPS_PREVIEW_PORT=8081
AGENTVPS_NAME=my-agent-computer
# AGENTVPS_DESKTOP=1 # enabled by the Ubuntu installer
# AGENTVPS_HOME=/var/lib/agentvps
# AGENTVPS_WORKSPACE=/var/lib/agentvps/workspace
# AGENTVPS_PUBLIC_URL=http://YOUR_VPS:8080
# AGENTVPS_PREVIEW_URL=http://YOUR_VPS:8081
# A random token is generated automatically. Do not commit a real token.

# Agents connect directly to /mcp using the service token.
# No separate local AgentVPS client is required.
